maintainer="Jonaz Thern <info@thern.io>"
pkgname=moraine
pkgver=0.3.1
pkgrel=0
pkgdesc="Snapshot-based backup application over SSH/rsync and rclone"
url="https://moraine.thern.io"
arch="all"
license="MIT"
depends="rsync openssh-client"
makedepends="
	cargo
	cargo-auditable
	gtk4.0-dev
	"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/TheJonaz/moraine-backup/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/moraine-backup-$pkgver"

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --release --frozen
}

check() {
	cargo test --frozen
}

package() {
	install -Dm755 target/release/moraine target/release/moraine-gui \
		-t "$pkgdir"/usr/bin/

	install -Dm644 assets/moraine-gui.desktop \
		-t "$pkgdir"/usr/share/applications/
	install -Dm644 assets/moraine.svg \
		-t "$pkgdir"/usr/share/icons/hicolor/scalable/apps/

	for _size in 48 64 128 256; do
		install -Dm644 assets/moraine-$_size.png \
			"$pkgdir"/usr/share/icons/hicolor/${_size}x${_size}/apps/moraine.png
	done

	# Runtime assets the GUI loads from /usr/share/moraine/assets.
	install -Dm644 assets/hero-bg.png assets/moraine-64.png assets/moraine-256.png \
		-t "$pkgdir"/usr/share/moraine/assets/

	install -Dm644 man/moraine.1 man/moraine-gui.1 \
		-t "$pkgdir"/usr/share/man/man1/

	install -Dm644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

sha512sums="
e1b5a9892b917a7a5575dce323d4bcb46a675eb55b854dcc04e990b71c216081ab223ff903f76af0214ae008622f888ca79c3272267e510a9a0199405bc5f47b  moraine-0.3.1.tar.gz
"
